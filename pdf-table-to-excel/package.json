    "check": "node --check src/server.mjs"
  },
  "engines": {
    "node": ">=20",
    "python": ">=3.10"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ipaddr.js": "2.5.0",
    "zod": "4.6.5"
  },
  "license": "MIT"
}
