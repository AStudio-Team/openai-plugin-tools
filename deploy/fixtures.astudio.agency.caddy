# BEGIN AI_CRAWLER_FIXTURES
fixtures.astudio.agency,
fixtures-ready.astudio.agency,
fixtures-robots-blocked.astudio.agency,
fixtures-llms-html.astudio.agency,
fixtures-invalid-jsonld.astudio.agency,
fixtures-sitemap-timeout.astudio.agency {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    reverse_proxy __CRAWLER_PLUGIN_UPSTREAM__:8790
}
# END AI_CRAWLER_FIXTURES
