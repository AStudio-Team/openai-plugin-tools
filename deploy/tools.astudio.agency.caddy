# BEGIN OPENAI_PLUGIN_TOOLS
    redir /tools /tools/ 308

    handle_path /tools/* {
        reverse_proxy __OPENAI_PLUGIN_UPSTREAM__:8788
    }

    handle /openai-plugins/pdf-table-to-excel/mcp {
        request_body {
            max_size 1MB
        }
        rewrite * /mcp
        reverse_proxy __OPENAI_PLUGIN_UPSTREAM__:8788
    }

    handle_path /openai-plugins/pdf-table-to-excel/* {
        reverse_proxy __OPENAI_PLUGIN_UPSTREAM__:8788
    }

    handle /.well-known/openai-apps-challenge {
        reverse_proxy __OPENAI_PLUGIN_UPSTREAM__:8788
    }
# END OPENAI_PLUGIN_TOOLS
