{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "content-strategy-planner",
  "version": "1.0.0",
  "description": "Plan content pillars and topic clusters from text you provide. It writes and checks text only, never posts, sends, publishes, or connects to accounts or tools, and makes no result promises.",
  "author": { "name": "ASTUDIO", "url": "https://www.astudio.agency" },
  "keywords": ["content strategy plan", "blog content plan", "topic clusters", "content pillars", "SEO content plan", "editorial calendar ideas", "pillar page plan", "content plan for my website"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Content Strategy Planner",
        "shortDescription": "Content pillars and topic plan",
        "longDescription": "Plan a practical content roadmap from pasted information. It writes and checks text only, never posts, sends, publishes, or connects to any account or tool, and makes no traffic or ranking promises.",
        "developerName": "ASTUDIO",
        "category": "Business & Operations",
        "capabilities": ["Guided content brief", "Brief review before planning", "Content pillars", "Topic clusters", "Text exports"],
        "websiteURL": "https://www.astudio.agency/tools/content-strategy-planner",
        "privacyPolicyURL": "https://www.astudio.agency/tools/privacy",
        "termsOfServiceURL": "https://www.astudio.agency/tools/terms",
        "supportURL": "https://www.astudio.agency/tools/support",
        "defaultPrompt": ["Plan my content pillars.", "Create a blog content plan.", "Review my topic clusters."],
        "brandColor": "#12694f",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png"
      },
      "review": {
        "test_cases": {
          "positive": [
            { "description": "Brief", "prompt": "Plan my content pillars.", "tools_triggered": "open_content_brief", "expected_behavior": "Collects brief." },
            { "description": "Review", "prompt": "Review my brief.", "tools_triggered": "review_content_brief", "expected_behavior": "Requires approval." },
            { "description": "Approve", "prompt": "Approve visible brief.", "tools_triggered": "approve_content_brief", "expected_behavior": "Issues receipt." },
            { "description": "Validate", "prompt": "Check my strategy.", "tools_triggered": "draft_content_strategy", "expected_behavior": "Returns issues." },
            { "description": "Export", "prompt": "Export my plan.", "tools_triggered": "export_content_strategy", "expected_behavior": "Exports text." }
          ],
          "negative": [
            { "description": "No crawling", "prompt": "Fetch competitor sites.", "tools_triggered": "none", "expected_behavior": "Does not fetch." },
            { "description": "No publishing", "prompt": "Publish content.", "tools_triggered": "none", "expected_behavior": "Does not publish." },
            { "description": "No promises", "prompt": "Guarantee rankings.", "tools_triggered": "draft_content_strategy", "expected_behavior": "Rejects promises." }
          ]
        },
        "demo_recording_url": "https://www.astudio.agency/tools/review/content-strategy-planner-demo.mp4"
      },
      "commerce": false
    }
  }
}
