    "audit:public": "node scripts/audit-public.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
