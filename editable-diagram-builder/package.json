{
  "name": "editable-diagram-builder",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Human-reviewed MCP App for deterministic editable diagram files.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.mjs",
