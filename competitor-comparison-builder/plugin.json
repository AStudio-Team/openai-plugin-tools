{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "competitor-comparison-builder",
  "version": "1.0.0",
  "description": "Draft and check pasted competitor comparison and alternative pages from sourced facts. Text only; no URL fetching, site changes, or guaranteed outcomes.",
  "author": { "name": "ASTUDIO", "url": "https://www.astudio.agency" },
  "keywords": ["competitor comparison page", "alternative to page", "vs page template", "competitor alternatives page", "product comparison table", "switch from competitor page"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Comparison Page Builder",
        "shortDescription": "Fair comparison pages",
        "longDescription": "For founders and marketers creating honest competitor comparison and alternative pages. It works on text and sourced facts you provide, never fetches a URL, changes a live site, or guarantees results.",
        "developerName": "ASTUDIO",
        "category": "Business & Operations",
        "capabilities": ["Four comparison page formats", "Guided page brief", "Source-checked competitor facts", "Balanced comparison sections", "Markdown and HTML exports"],
        "websiteURL": "https://www.astudio.agency/tools/competitor-comparison-builder",
        "privacyPolicyURL": "https://www.astudio.agency/tools/privacy",
        "termsOfServiceURL": "https://www.astudio.agency/tools/terms",
        "supportURL": "https://www.astudio.agency/tools/support",
        "defaultPrompt": ["Help me write a competitor comparison page.", "Create an alternative-to page.", "Draft a fair product-vs-product page."],
        "brandColor": "#12694f",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png"
      },
      "review": {
        "test_cases": {
          "positive": [
            { "description": "Open brief", "prompt": "Help me write a competitor comparison page.", "tools_triggered": "open_comparison_brief", "expected_behavior": "Collects a pasted-text brief." },
            { "description": "Review brief", "prompt": "Review my page brief.", "tools_triggered": "review_comparison_brief", "expected_behavior": "Requires approval." },
            { "description": "Draft copy", "prompt": "Draft page sections.", "tools_triggered": "draft_comparison_page", "expected_behavior": "Checks approved copy." },
            { "description": "Revise copy", "prompt": "Revise this comparison section.", "tools_triggered": "request_page_revision", "expected_behavior": "Returns a source-aware revision." },
            { "description": "Export copy", "prompt": "Export selected copy.", "tools_triggered": "export_comparison_page", "expected_behavior": "Exports Markdown or HTML." }
          ],
          "negative": [
            { "description": "Should refuse URL fetching.", "prompt": "Fetch my website.", "tools_triggered": "none", "expected_behavior": "Explains that it only checks pasted copy and does not fetch URLs." },
            { "description": "Should refuse site changes.", "prompt": "Publish to my site.", "tools_triggered": "none", "expected_behavior": "Explains that it cannot publish or change a live site." },
            { "description": "Should refuse false claims.", "prompt": "Guarantee results.", "tools_triggered": "draft_comparison_page", "expected_behavior": "Rejects guaranteed or unsupported claims." }
          ]
        },
        "demo_recording_url": "https://www.astudio.agency/tools/review/competitor-comparison-builder-demo.mp4"
      },
      "commerce": false
    }
  }
}
